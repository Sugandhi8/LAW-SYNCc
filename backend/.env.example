# LAW-SYNCc Backend Environment Configuration

# Server Port and Environment
PORT=5000
NODE_ENV=development

# Allowed Frontend Client Origins (comma-separated or single URL)
CLIENT_URL=http://localhost:5173

# JWT Secret Key for Session Authentication
JWT_SECRET=lawsync_super_secret_jwt_key_2026_dev

# Option A: Hosted Database URL (e.g. Supabase, Neon, Render, Railway, AWS RDS)
# DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require

# Option B: Individual PostgreSQL Database Connection Parameters
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=legal_dictionary
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_DIALECT=postgres
DB_SSL=false
